# ============================================================================
# AI Weather 环境变量模板
# 复制为 .env 后填入实际值:  cp .env.example .env
# ============================================================================

# ── gRPC 连接 ──
GRPC_ADDR=polymorph:50051
GRPC_PORT=50051

# ── Rust 执行层 ──
RUST_LOG=info
CHAIN_ID=137
CLOB_HOST=https://clob.polymarket.com

# 钱包 (敏感信息, 务必妥善保管)
WALLET_ADDRESS=
WALLET_PASSWORD=
KEYSTORE_PATH=/app/keystore.json

# ── Python 策略引擎 ──
AGG_BASE_CAPITAL=1000.0
AGG_KELLY_FRACTION=0.25
AGG_MAX_POSITION=1000.0
AGG_MAX_GLOBAL_EXPOSURE=5000.0

# ── 气象数据 API (可选) ──
NOAA_API_KEY=
CAIYUN_API_KEY=
ECMWF_API_KEY=
JMA_API_KEY=

# ── Polymarket API ──
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
